---
import { AUTHOR_NAME, CONTACT_EMAIL, GITHUB_URL, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<a href="/" class="site-footer__mark" aria-label={`${SITE_TITLE} home`}>MP</a>
		<p>
			<span>&copy; {today.getFullYear()} {AUTHOR_NAME}</span>
			<span>All rights reserved.</span>
		</p>
		<p class="site-footer__note">
			<span>Built with curiosity, shipped with care.</span>
			<a href="/">{SITE_TITLE}</a>
		</p>
		<div class="site-footer__links">
			<a href={GITHUB_URL} target="_blank" rel="noreferrer">
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.6 7.6 0 0 1 8 3.36c.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
					/>
				</svg>
				<span>GitHub</span>
			</a>
			<a href="/rss.xml">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M6.18 17.82A2.18 2.18 0 1 1 1.82 17.82a2.18 2.18 0 0 1 4.36 0ZM2 9.8v3.08a9.13 9.13 0 0 1 9.12 9.12h3.08C14.2 15.27 8.73 9.8 2 9.8Zm0-5.62v3.1c8.11 0 14.72 6.6 14.72 14.72h3.1C19.82 12.18 11.82 4.18 2 4.18Z"
					/>
				</svg>
				<span>RSS</span>
			</a>
			<a href={`mailto:${CONTACT_EMAIL}`}>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-.4 4.25-7.06 5.05a1 1 0 0 1-1.16 0L4.4 8.25 5.56 6.62 12 11.27l6.44-4.65 1.16 1.63Z"
					/>
				</svg>
				<span>Email</span>
			</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 16px;
		border-top: 1px solid rgba(204, 125, 73, 0.32);
		background: rgba(7, 8, 9, 0.74);
	}

	:root[data-theme='light'] .site-footer {
		background: rgba(238, 228, 216, 0.78);
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: auto minmax(170px, 1fr) minmax(240px, 1.2fr) auto;
		align-items: center;
		gap: 32px;
		width: min(calc(100% - 128px), 1328px);
		margin: 0 auto;
		padding: 24px 0;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.site-footer__mark {
		padding-right: 28px;
		border-right: 1px solid var(--color-border);
		color: var(--color-accent-strong);
		font-family: var(--font-serif);
		font-size: 1.55rem;
		line-height: 1;
		text-decoration: none;
	}

	.site-footer p {
		display: grid;
		gap: 2px;
		margin: 0;
	}

	.site-footer__note a {
		color: var(--color-accent-strong);
		text-decoration: none;
	}

	.site-footer__links {
		display: flex;
		align-items: center;
		gap: 28px;
	}

	.site-footer__links a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--color-muted);
		text-decoration: none;
	}

	.site-footer__links svg {
		width: 18px;
		height: 18px;
	}

	.site-footer__links a:hover {
		color: var(--color-accent-strong);
	}

	@media (max-width: 820px) {
		.site-footer__inner {
			grid-template-columns: auto 1fr;
		}

		.site-footer__note,
		.site-footer__links {
			grid-column: 2;
		}

		.site-footer__links {
			flex-wrap: wrap;
		}
	}

	@media (max-width: 520px) {
		.site-footer__inner {
			grid-template-columns: 1fr;
			width: min(calc(100% - 36px), 1240px);
			padding: 26px 0;
		}

		.site-footer__mark {
			width: max-content;
			padding-right: 0;
			border-right: 0;
		}

		.site-footer__note,
		.site-footer__links {
			grid-column: auto;
		}
	}
</style>
