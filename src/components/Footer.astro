---
import { AUTHOR_NAME, CONTACT_EMAIL, LINKEDIN_URL, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<a href="/" class="site-footer__mark" aria-label={`${SITE_TITLE} home`}>MP</a>
		<p>
			<span>&copy; {today.getFullYear()} {AUTHOR_NAME}</span>
			<span>All rights reserved.</span>
		</p>
		<p class="site-footer__note">
			<span>Built with curiosity, shipped with care.</span>
			<a href="/">{SITE_TITLE}</a>
		</p>
		<div class="site-footer__links">
			<a
				href={LINKEDIN_URL}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="LinkedIn profile"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99h3.42v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.1 20.45H3.54V8.99H7.1v11.46Z"
					/>
				</svg>
				<span>LinkedIn</span>
			</a>
			<a href="/rss.xml">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M6.18 17.82A2.18 2.18 0 1 1 1.82 17.82a2.18 2.18 0 0 1 4.36 0ZM2 9.8v3.08a9.13 9.13 0 0 1 9.12 9.12h3.08C14.2 15.27 8.73 9.8 2 9.8Zm0-5.62v3.1c8.11 0 14.72 6.6 14.72 14.72h3.1C19.82 12.18 11.82 4.18 2 4.18Z"
					/>
				</svg>
				<span>RSS</span>
			</a>
			<a href={`mailto:${CONTACT_EMAIL}`}>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-.4 4.25-7.06 5.05a1 1 0 0 1-1.16 0L4.4 8.25 5.56 6.62 12 11.27l6.44-4.65 1.16 1.63Z"
					/>
				</svg>
				<span>Email</span>
			</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 16px;
		border-top: 1px solid rgba(204, 125, 73, 0.32);
		background: rgba(7, 8, 9, 0.74);
	}

	:root[data-theme='light'] .site-footer {
		background: rgba(238, 228, 216, 0.78);
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: auto minmax(170px, 1fr) minmax(240px, 1.2fr) auto;
		align-items: center;
		gap: 32px;
		width: min(calc(100% - 128px), 1328px);
		margin: 0 auto;
		padding: 24px 0;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.site-footer__mark {
		padding-right: 28px;
		border-right: 1px solid var(--color-border);
		color: var(--color-accent-strong);
		font-family: var(--font-serif);
		font-size: 1.55rem;
		line-height: 1;
		text-decoration: none;
	}

	.site-footer p {
		display: grid;
		gap: 2px;
		margin: 0;
	}

	.site-footer__note a {
		color: var(--color-accent-strong);
		text-decoration: none;
	}

	.site-footer__links {
		display: flex;
		align-items: center;
		gap: 28px;
	}

	.site-footer__links a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--color-muted);
		text-decoration: none;
	}

	.site-footer__links svg {
		width: 18px;
		height: 18px;
	}

	.site-footer__links a:hover {
		color: var(--color-accent-strong);
	}

	@media (max-width: 820px) {
		.site-footer__inner {
			grid-template-columns: auto 1fr;
		}

		.site-footer__note,
		.site-footer__links {
			grid-column: 2;
		}

		.site-footer__links {
			flex-wrap: wrap;
		}
	}

	@media (max-width: 520px) {
		.site-footer__inner {
			grid-template-columns: 1fr;
			width: min(calc(100% - 36px), 1240px);
			padding: 26px 0;
		}

		.site-footer__mark {
			width: max-content;
			padding-right: 0;
			border-right: 0;
		}

		.site-footer__note,
		.site-footer__links {
			grid-column: auto;
		}
	}
</style>
