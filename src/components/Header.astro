---
import { LINKEDIN_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="site-nav" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand__mark" aria-hidden="true">MP</span>
			<span class="brand__name">{SITE_TITLE}</span>
		</a>

		<div class="site-nav__links">
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/notes">Notes</a>
			<a href="/uses">Uses</a>
			<a
				href={LINKEDIN_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="social-link"
				aria-label="LinkedIn profile"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99h3.42v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.1 20.45H3.54V8.99H7.1v11.46Z"
					/>
				</svg>
				<span>LinkedIn</span>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(204, 125, 73, 0.28);
		background: rgba(7, 8, 9, 0.78);
		backdrop-filter: blur(18px);
	}

	:root[data-theme='light'] .site-header {
		background: rgba(245, 239, 230, 0.82);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(calc(100% - 128px), 1328px);
		min-height: 70px;
		margin: 0 auto;
		padding: 0;
		gap: 28px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 28px;
		min-width: 0;
		color: var(--color-text);
		text-decoration: none;
	}

	.brand__mark {
		color: var(--color-accent-strong);
		font-family: var(--font-serif);
		font-size: 1.62rem;
		line-height: 1;
	}

	.brand__name {
		color: var(--color-text);
		font-size: 1.03rem;
		white-space: nowrap;
	}

	.site-nav__links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 31px;
		font-size: 0.95rem;
	}

	.site-nav__links a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 70px;
		color: var(--color-text);
		text-decoration: none;
	}

	.site-nav__links a:hover {
		color: var(--color-accent-strong);
	}

	.site-nav__links a.active::after {
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		height: 1px;
		background: var(--color-accent);
		box-shadow: 0 0 0 4px var(--color-bg), 0 0 0 5px var(--color-accent);
		content: '';
	}

	.social-link {
		gap: 8px;
		padding-left: 28px;
		border-left: 1px solid var(--color-border);
	}

	.social-link svg {
		width: 18px;
		height: 18px;
	}

	@media (max-width: 760px) {
		.site-nav {
			align-items: stretch;
			flex-direction: column;
			min-height: auto;
			width: 100%;
			gap: 10px;
			padding: 14px 18px 16px;
		}

		.site-nav__links {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(48px, 0.72fr);
			width: 100%;
			gap: 0;
			font-size: clamp(0.92rem, 3.4vw, 1.05rem);
		}

		.site-nav__links a {
			justify-content: center;
			min-width: 0;
			min-height: 32px;
		}

		.social-link {
			padding-left: 0;
			border-left-color: rgba(226, 199, 172, 0.22);
		}

		.social-link span {
			display: none;
		}
	}

	@media (max-width: 430px) {
		.brand {
			gap: 16px;
		}

		.brand__name {
			font-size: 0.95rem;
		}

		.site-nav {
			padding-right: 16px;
			padding-left: 16px;
		}
	}
</style>
