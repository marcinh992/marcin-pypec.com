---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="site-nav" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand__mark" aria-hidden="true">MP</span>
			<span class="brand__name">{SITE_TITLE}</span>
		</a>

		<div class="site-nav__links">
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/notes">Notes</a>
			<a href="/uses">Uses</a>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer" class="github-link">
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.6 7.6 0 0 1 8 3.36c.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
					/>
				</svg>
				<span>GitHub</span>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(204, 125, 73, 0.28);
		background: rgba(7, 8, 9, 0.78);
		backdrop-filter: blur(18px);
	}

	:root[data-theme='light'] .site-header {
		background: rgba(245, 239, 230, 0.82);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(calc(100% - 128px), 1328px);
		min-height: 70px;
		margin: 0 auto;
		padding: 0;
		gap: 28px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 28px;
		min-width: 0;
		color: var(--color-text);
		text-decoration: none;
	}

	.brand__mark {
		color: var(--color-accent-strong);
		font-family: var(--font-serif);
		font-size: 1.62rem;
		line-height: 1;
	}

	.brand__name {
		color: var(--color-text);
		font-size: 1.03rem;
		white-space: nowrap;
	}

	.site-nav__links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 31px;
		font-size: 0.95rem;
	}

	.site-nav__links a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 70px;
		color: var(--color-text);
		text-decoration: none;
	}

	.site-nav__links a:hover {
		color: var(--color-accent-strong);
	}

	.site-nav__links a.active::after {
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		height: 1px;
		background: var(--color-accent);
		box-shadow: 0 0 0 4px var(--color-bg), 0 0 0 5px var(--color-accent);
		content: '';
	}

	.github-link {
		gap: 8px;
		padding-left: 28px;
		border-left: 1px solid var(--color-border);
	}

	.github-link svg {
		width: 18px;
		height: 18px;
	}

	@media (max-width: 760px) {
		.site-nav {
			align-items: stretch;
			flex-direction: column;
			min-height: auto;
			width: 100%;
			gap: 10px;
			padding: 14px 18px 16px;
		}

		.site-nav__links {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(48px, 0.72fr);
			width: 100%;
			gap: 0;
			font-size: clamp(0.92rem, 3.4vw, 1.05rem);
		}

		.site-nav__links a {
			justify-content: center;
			min-width: 0;
			min-height: 32px;
		}

		.github-link {
			padding-left: 0;
			border-left-color: rgba(226, 199, 172, 0.22);
		}

		.github-link span {
			display: none;
		}
	}

	@media (max-width: 430px) {
		.brand {
			gap: 16px;
		}

		.brand__name {
			font-size: 0.95rem;
		}

		.site-nav {
			padding-right: 16px;
			padding-left: 16px;
		}
	}
</style>
