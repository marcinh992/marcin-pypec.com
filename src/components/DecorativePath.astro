---
interface Props {
	segment: 'hero' | 'featured' | 'feed';
}

const { segment } = Astro.props;
const heights = { hero: 536, featured: 222, feed: 320 };
---

<svg
	class:list={['decorative-path', `decorative-path--${segment}`]}
	viewBox={`0 0 1200 ${heights[segment]}`}
	preserveAspectRatio="none"
	fill="none"
	aria-hidden="true"
	focusable="false"
>
	{
		segment === 'hero' && (
			<>
				<path d="M0 0 H604 C628 0 640 16 640 40 V135
					C640 175 635 202 602 223 C572 242 570 263 570 290 V345
					C570 368 549 380 520 390 C472 408 446 446 472 475
					C496 503 535 502 570 502 C592 502 600 515 600 536" />
				<path class="decorative-path__branch" d="M640 92 H680" />
				<circle cx="640" cy="92" r="5" />
				<circle cx="570" cy="345" r="5" />
			</>
		)
	}
	{
		segment === 'featured' && (
			<>
				<path d="M600 0 V30 Q600 60 630 60 H696 V174 Q696 222 648 222 H20" />
				<path class="decorative-path__branch" d="M696 60 H725" />
				<circle cx="696" cy="60" r="5" />
			</>
		)
	}
	{
		segment === 'feed' && (
			<>
				<path d="M20 0 Q-12 0 -12 32 V288 Q-12 320 -44 320 H-120" />
				<circle cx="-12" cy="88" r="5" />
				<circle class="decorative-path__footer-node" cy="320" r="5" />
			</>
		)
	}
</svg>

{
	segment === 'feed' && (
		<svg class="decorative-path-compact" viewBox="0 0 120 16" fill="none" aria-hidden="true" focusable="false">
			<path d="M0 8 H120" />
			<circle cx="28" cy="8" r="4" />
		</svg>
	)
}

<style>
	.decorative-path,
	.decorative-path-compact {
		position: absolute;
		z-index: -1;
		display: block;
		pointer-events: none;
		stroke: var(--color-accent);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.35;
	}

	.decorative-path {
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* Each segment follows its section, keeping the junctions aligned as content grows. */
	.decorative-path--hero {
		top: -54px;
		height: calc(100% + 54px);
	}

	.decorative-path--feed {
		height: calc(100% + 16px);
	}

	path,
	circle {
		vector-effect: non-scaling-stroke;
	}

	path {
		opacity: 0.78;
	}

	.decorative-path__branch {
		opacity: 0.52;
	}

	circle {
		fill: var(--color-bg);
		stroke-width: 1.5;
	}

	.decorative-path__footer-node {
		cx: max(-84px, calc(16px - (100vw - 1200px) / 2));
	}

	.decorative-path-compact {
		bottom: -24px;
		left: 0;
		display: none;
		width: 120px;
		height: 16px;
	}

	/* The full route needs the homepage's 1200px content width. */
	@media (max-width: 1263px) {
		.decorative-path {
			display: none;
		}

		.decorative-path-compact {
			display: block;
		}
	}
</style>
