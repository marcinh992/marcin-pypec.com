---
import type { BlogPost } from '../lib/articles';
import { getPrimaryTag, getReadingMinutes } from '../lib/articles';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: BlogPost;
}

const { post } = Astro.props;
const tag = getPrimaryTag(post);
const minutes = getReadingMinutes(post);
---

<article class="article-card">
	<a href={`/blog/${post.id}/`} class="article-card__link">
		<h3>{post.data.title}</h3>
		<p>{post.data.description}</p>
		<div class="article-card__meta">
			<span class="article-card__details">
				<FormattedDate date={post.data.pubDate} />
				<span aria-hidden="true">·</span>
				<span>{minutes} min read</span>
			</span>
			<span class="article-card__tag">{tag}</span>
		</div>
	</a>
</article>

<style>
	.article-card {
		min-height: 156px;
		border: 1px solid rgba(226, 199, 172, 0.13);
		border-radius: 8px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 46%),
			rgba(18, 20, 22, 0.86);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.028);
		transition:
			border-color 180ms ease,
			transform 180ms ease,
			background 180ms ease;
	}

	.article-card:hover {
		border-color: var(--color-border-strong);
		background:
			linear-gradient(135deg, rgba(204, 125, 73, 0.11), transparent 48%),
			var(--color-panel-strong);
		transform: translateY(-2px);
	}

	.article-card__link {
		display: flex;
		height: 100%;
		flex-direction: column;
		padding: 17px 18px 16px;
		text-decoration: none;
	}

	h3 {
		margin-bottom: 12px;
		font-size: clamp(1.02rem, 1.12vw, 1.08rem);
		line-height: 1.08;
	}

	p {
		flex: 0 0 auto;
		margin-bottom: 18px;
		font-size: 0.86rem;
		line-height: 1.5;
	}

	.article-card__meta {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 10px;
		margin-top: auto;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		line-height: 1.3;
	}

	.article-card__details {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
		white-space: nowrap;
	}

	.article-card__tag {
		padding: 3px 8px;
		border: 1px solid rgba(204, 125, 73, 0.32);
		border-radius: 5px;
		background: rgba(204, 125, 73, 0.07);
		color: var(--color-accent-strong);
	}

	@media (max-width: 620px) {
		.article-card__link {
			padding: 20px;
		}

		.article-card__tag {
			margin-left: 0;
		}

		.article-card__meta {
			grid-template-columns: 1fr;
		}
	}
</style>
