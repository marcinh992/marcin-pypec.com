---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPrimaryTag, getReadingMinutes, sortPostsByDate } from '../../lib/articles';

const posts = sortPostsByDate(await getCollection('blog'));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(calc(100% - 64px), 1200px);
				margin: 0 auto;
				padding: 64px 0 72px;
			}

			.blog-heading {
				display: grid;
				grid-template-columns: minmax(0, 0.9fr) minmax(280px, 0.55fr);
				gap: 48px;
				align-items: end;
				margin-bottom: 34px;
			}

			.blog-heading__eyebrow {
				margin-bottom: 12px;
				color: var(--color-accent-strong);
				font-family: var(--font-mono);
				font-size: 0.78rem;
				text-transform: uppercase;
			}

			h1 {
				max-width: 680px;
				margin: 0;
				font-size: clamp(3.2rem, 7vw, 5.3rem);
				line-height: 0.98;
			}

			.blog-heading__summary {
				max-width: 420px;
				margin: 0 0 8px;
				font-size: 1.02rem;
				line-height: 1.62;
			}

			.article-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 16px;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.article-card {
				min-height: 220px;
			}

			.article-card a {
				display: flex;
				height: 100%;
				flex-direction: column;
				padding: 24px;
				border: 1px solid rgba(226, 199, 172, 0.13);
				border-radius: 8px;
				background:
					linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 46%),
					rgba(18, 20, 22, 0.86);
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.028);
				text-decoration: none;
				transition:
					border-color 180ms ease,
					background 180ms ease,
					transform 180ms ease;
			}

			.article-card a:hover {
				border-color: var(--color-border-strong);
				background:
					linear-gradient(135deg, rgba(204, 125, 73, 0.11), transparent 48%),
					var(--color-panel-strong);
				transform: translateY(-2px);
			}

			.article-card__eyebrow {
				margin-bottom: 14px;
				color: var(--color-accent);
				font-family: var(--font-mono);
				font-size: 0.75rem;
				text-transform: uppercase;
			}

			.article-card h2 {
				margin-bottom: 14px;
				font-size: clamp(1.55rem, 2.6vw, 2.25rem);
				line-height: 1.02;
			}

			.article-card__description {
				max-width: 560px;
				font-size: 0.96rem;
				line-height: 1.56;
			}

			.article-card__meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 8px 10px;
				margin-top: auto;
				color: var(--color-muted);
				font-family: var(--font-mono);
				font-size: 0.74rem;
			}

			.article-card__tag {
				padding: 3px 8px;
				border: 1px solid rgba(204, 125, 73, 0.32);
				border-radius: 5px;
				background: rgba(204, 125, 73, 0.07);
				color: var(--color-accent-strong);
			}

			.empty-state {
				margin: 0;
				padding: 28px;
				border: 1px solid var(--color-border);
				border-radius: 8px;
				background: var(--color-panel);
			}

			@media (max-width: 820px) {
				main {
					width: min(calc(100% - 36px), 1200px);
					padding: 42px 0 60px;
				}

				.blog-heading {
					grid-template-columns: 1fr;
					gap: 16px;
					margin-bottom: 28px;
				}

				.blog-heading__summary {
					max-width: 620px;
				}

				.article-list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="blog-heading">
					<div>
						<p class="blog-heading__eyebrow">Articles</p>
						<h1>Notes from building software.</h1>
					</div>
					<p class="blog-heading__summary">
						Long-form writing on pull requests, code review, architecture, and the engineering habits
						that compound over time.
					</p>
				</div>
				{
					posts.length === 0 ? (
						<p class="empty-state">No articles published yet.</p>
					) : (
						<ul class="article-list">
							{posts.map((post) => {
								const tag = getPrimaryTag(post);
								const minutes = getReadingMinutes(post);

								return (
									<li class="article-card">
										<a href={`/blog/${post.id}/`}>
											<p class="article-card__eyebrow">{tag}</p>
											<h2>{post.data.title}</h2>
											<p class="article-card__description">{post.data.description}</p>
											<div class="article-card__meta">
												<FormattedDate date={post.data.pubDate} />
												<span aria-hidden="true">·</span>
												<span>{minutes} min read</span>
												<span aria-hidden="true">·</span>
												<span class="article-card__tag">{tag}</span>
											</div>
										</a>
									</li>
								);
							})}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
